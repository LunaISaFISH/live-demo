# Copy to .env in this folder (never commit it). server.py reads it at start;
# values already set in the shell take precedence.
# Optional: log Codex in with an API key instead of this machine's ChatGPT login.
OPENAI_API_KEY=
# Or use OpenRouter. A nonempty OPENROUTER_API_KEY selects it automatically.
OPENROUTER_API_KEY=
# Optional:
# FITCOACH_PROVIDER=openrouter
# OpenAI/Codex login model:
# FITCOACH_MODEL=gpt-5.6-terra
# OpenRouter model (full slug):
# FITCOACH_MODEL=openai/gpt-5.6-terra
# FITCOACH_REASONING_EFFORT=medium
# FITCOACH_TURN_TIMEOUT=300
# FITCOACH_PORT=8765
